# ==============================================================================
# TalkBuddy - Environment Variables Template for Vercel Deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# PostgreSQL database connection URL (Neon, Supabase, AWS RDS, etc.)
# For serverless platforms like Vercel, use a pooled connection string:
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional: Max concurrent connections per serverless function instance (Default: 5)
# DB_POOL_MAX=5

# ------------------------------------------------------------------------------
# 2. TELEGRAM BOT CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Token obtained from @BotFather on Telegram:
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# The username of your Telegram Bot (without @)
TELEGRAM_BOT_USERNAME="TalkBuddyGlobalBot"

# Optional: Secret token for verifying webhook requests from Telegram
# Provide an arbitrary alphanumeric string (1-256 chars, A-Z, a-z, 0-9, _, -)
# TELEGRAM_WEBHOOK_SECRET="your_custom_webhook_secret_here"

# ------------------------------------------------------------------------------
# 3. APPLICATION URL (Required for production metadata & webhook helpers)
# ------------------------------------------------------------------------------
# Your public Vercel deployment URL:
NEXT_PUBLIC_APP_URL="https://your-talkbuddy-deployment.vercel.app"

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 MEDIA STORAGE (Required if using photo/voice/video messaging)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="talkbuddy-media"
R2_S3_API_ENDPOINT="https://your_cloudflare_account_id.r2.cloudflarestorage.com"
